!results/*.csv
experiments/*/results/

# HPC job logs
slurm-*.out
slurm/logs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# OS
.DS_Store

