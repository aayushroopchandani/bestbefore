# Copy to .env and fill in. .env is gitignored.

# The unpacked ExpDate download
# (https://felizang.github.io/expdate/index_expdate.html)
EXPDATE_DIR=data/expdate

# The folder holding the retailer's store photos: samples1/ to samples3/
# (store test set v1) and testset2/ (store test set v2, test only). Never
# commit them.
STORE_PHOTOS_DIR=

# The Scanify repo, for baseline B (app.scanner.scan)
SCANIFY_DIR=

# Where training writes model weights and plots. On the cluster:
# ~/bestbefore-data/checkpoints
CHECKPOINT_DIR=data/checkpoints

# Where M2 writes its derived and generated photos. On the cluster:
# ~/bestbefore-data/generated
GENERATED_DIR=data/generated

# Store set v1 exported for training (M2b, S6): numbered copies of the
# retailer's photos. Never commit them. Laptop data/store/train, cluster
# ~/bestbefore-data/store (chmod 700)
STORE_TRAIN_DIR=
